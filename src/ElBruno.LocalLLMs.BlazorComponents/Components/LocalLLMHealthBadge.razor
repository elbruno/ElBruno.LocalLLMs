@implements IDisposable

<span class="llm-health-badge llm-health-@_viewModel.State" title="@_viewModel.Tooltip">
    @_viewModel.Icon @_viewModel.Label
</span>

@code {
    /// <summary>
    /// Optional loaded chat client. When null the badge shows "Not configured".
    /// </summary>
    [Parameter] public LocalChatClient? Client { get; set; }

    /// <summary>
    /// Auto-refresh interval. Set to zero to disable polling.
    /// Default: every 30 seconds.
    /// </summary>
    [Parameter] public TimeSpan RefreshInterval { get; set; } = TimeSpan.FromSeconds(30);

    private LocalLLMHealthBadgeViewModel _viewModel = new("unknown", "◌", "LLM…", string.Empty);
    private Timer? _timer;

    protected override void OnParametersSet() => Refresh();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && RefreshInterval > TimeSpan.Zero)
            _timer = new Timer(_ => InvokeAsync(() => { Refresh(); StateHasChanged(); }),
                null, RefreshInterval, RefreshInterval);
    }

    private void Refresh()
    {
        if (Client is null)
        {
            _viewModel = LocalLLMHealthBadgePresenter.CreateNotConfigured();
            return;
        }

        var diagnostics = LocalChatClient.DiagnoseEnvironment();
        _viewModel = LocalLLMHealthBadgePresenter.Create(diagnostics, Client);
    }

    public void Dispose() => _timer?.Dispose();
}
